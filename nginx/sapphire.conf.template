# ================================================
# Sapphire AI - Nginx Configuration Template
#
# DO NOT edit this file directly.
# Variables are replaced by setup script at deploy time.
#
# Variables:
#   {{DOMAIN}}          - Customer's domain (or IP)
#   {{BACKEND_HOST}}    - Spring Boot host (default: 127.0.0.1)
#   {{BACKEND_PORT}}    - Spring Boot port (default: 8080)
#   {{SSL_CERT_PATH}}   - Path to SSL cert (Let's Encrypt or customer-provided)
#   {{SSL_KEY_PATH}}    - Path to SSL key
#   {{SSL_CHAIN_PATH}}  - Path to SSL chain (empty if self-signed)
#   {{UI_STATIC_PATH}}  - Path to Svelte UI dist folder
#   {{LOG_PATH}}        - Log directory
# ================================================

# HTTP block
server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Health check — never redirect (load balancers, Docker healthchecks)
    location = /actuator/health {
        proxy_pass http://{{BACKEND_HOST}}:{{BACKEND_PORT}};
        proxy_set_header Host $host;
    }

    # Redirect all HTTP → HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{DOMAIN}};

    # ─── SSL Certificates ───
    # Supports three scenarios:
    #   1. Let's Encrypt (public domain)
    #   2. Customer-provided cert (private VPC with internal CA)
    #   3. Self-signed (internal testing)
    ssl_certificate {{SSL_CERT_PATH}};
    ssl_certificate_key {{SSL_KEY_PATH}};
    {{SSL_CHAIN_DIRECTIVE}}

    # ─── SSL Hardening ───
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE+AESGCM:DHE+AESGCM:HIGH:!aNULL:!MD5:!RC4;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # ─── Security Headers ───
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # ─── Proxy to Spring Boot ───
    location / {
        proxy_pass http://{{BACKEND_HOST}}:{{BACKEND_PORT}};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_http_version 1.1;
        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;

        proxy_buffer_size 16k;
        proxy_buffers 4 32k;
    }

    # ─── Static files (Svelte UI) ───
    location /assets/ {
        alias {{UI_STATIC_PATH}}/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # ─── Logging ───
    access_log {{LOG_PATH}}/sapphire_access.log;
    error_log  {{LOG_PATH}}/sapphire_error.log;
}